# EOL normalization — single source of truth for line endings.
# Kills the recurring CRLF/LF churn when worktrees are created on Windows while
# CI normalizes on Linux. Text files are stored LF in the repo; Windows checkouts
# no longer flip them. Run `git add --renormalize .` once if historical files drift.

# Default: treat as text, store LF, auto-detect on the way in.
* text=auto eol=lf

# ── Source ────────────────────────────────────────────────────────────────────
*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.slnx      text eol=lf
*.editorconfig text eol=lf
*.runsettings  text eol=lf

*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf

# ── PowerShell (PS7 is cross-platform; LF is correct) ──────────────────────────
*.ps1       text eol=lf
*.psm1      text eol=lf
*.psd1      text eol=lf

# ── Config / data / docs ──────────────────────────────────────────────────────
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.xml       text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.env       text eol=lf
Dockerfile  text eol=lf
*.dockerignore text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# ── Windows-only scripts must stay CRLF ────────────────────────────────────────
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.sln       text eol=crlf

# ── Binary (never normalize) ───────────────────────────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.gz        binary
