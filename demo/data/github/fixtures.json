  "_doc": {
    "purpose": "Curated GitHub fixture mirroring demo/data/events.json exactly — 10 services, same envs, same sha/ref/version/actor/status outcomes.",
    "f10": "payments-api has a full dev→staging→qa→preprod→prod deployment-job needs chain. auth-bff, catalog-edge, ledger-projector, notification-worker, order-svc also have multi-env needs chains matching their events.json topologies.",
    "f15": "search-indexer uses artifact:version.txt on every deployment (F15). Artifact content matches the version string from events.json.",
    "status_states": "in-progress events from events.json → single in_progress GitHub status (no terminal). success/failure events → in_progress + terminal status.",
    "run_ids": "run_id values are taken from events.json run_number fields so target_url patterns are consistent.",
    "multi_run": "Services with multiple runs (auth-bff: 3300/3210/3200, order-svc: 2960/2940/2920, etc.) have a deployment object per run per env. The fetcher backfill picks the newest per (service, env).",
    "disconnected": "billing-webhook has five separate run_ids (one per env) — fully disconnected as in events.json.",
    "target_url": "Every status target_url embeds /actions/runs/{run_id} for fetcher §5.6.1 run-id extraction."
  },
