{
  "_doc": {
    "model": "Parent→child edges mean 'same pipeline run promoted across environments'. A node's parent_deployments references the SAME-RUN upstream-env deployment_id, which is present in the matrix as that cell's current (or last_successful). Deployments from DIFFERENT runs are intentionally NOT linked and render as disconnected nodes — that is correct behaviour, not a gap. Therefore the matrix (current + last_successful per cell) is sufficient to draw the swimlane DAG; no deployment-history endpoint is needed.",
    "run_number": "All env deployments produced by one workflow run share the same run_number (and run_url); each env still gets its own deployment_id (gh-{svc}-{env}-{run}). Same run_number across a chain is what makes the 'same run_number' correlation predicate agree with 'explicit parent'.",
    "elapsed_minutes": "Minutes before 'now'. Consumers derive happened_at = Date.now() - elapsed_minutes*60000. Within one promotion the upstream env is older (larger elapsed) and the downstream env is newer (smaller elapsed); an in-progress tip is newest.",
    "scenarios": {
      "payments-api":        "FULLY CONNECTED — one run (4830, v2.15.0) promoted dev→staging→qa→preprod→prod; single chain.",
      "search-indexer":      "FULLY CONNECTED — one run (1410, v0.8.0) promoted through all five envs.",
      "auth-bff":            "PARTIAL — new run 3300 (v3.3.0) in flight dev→staging→qa(in-progress); older run 3210 (v3.2.4) holds preprod→prod; qa also shows last_successful from run 3200 as a lone node. dev/staging/qa are disconnected from preprod/prod (different runs).",
      "order-svc":           "FAN-IN MERGE — run 2960 (v0.42.0) dev→staging→qa where qa lists TWO parents (dev AND staging of the same run); preprod (run 2940) and prod (run 2920, ref-only fallback) are separate lone nodes.",
      "billing-webhook":     "FULLY DISCONNECTED — every env from a different run (822/825/810/801/792), no parents → five separate nodes. staging is an in-progress first-ever deploy (no actor).",
      "catalog-edge":        "PARTIAL — run 5160 (v5.0.0-rc2) dev→staging→qa(in-progress, first-ever to qa, no actor); older run 5145 (v4.18.7) holds preprod→prod.",
      "ledger-projector":    "PARTIAL — run 1830 (v2.0.1) dev→staging; qa is a lone in-progress retry (run 1828) after a failure; older run 1802 (v1.9.8) holds preprod→prod.",
      "notification-worker": "PARTIAL — run 3110 (v1.9.1) dev→staging(FAILURE) with staging last_successful (run 3081, sha-only fallback) as a lone node; older run 3076 (v1.8.4) holds qa→preprod; prod (run 3041) is a lone node.",
      "platform-proxy":     "LONG VERSION (early stages) — run 6200 (v2.0.0-beta.3+build.20250530) on dev(success) + staging(in-progress) only; no qa/preprod/prod yet.",
      "data-pipeline":      "LONG VERSION (late stages) — run 7100 (v1.99.0-hotfix.csrf-protection) on preprod(success) + prod(in-progress) only; earlier stages already gone."
    },
    "fallback_fields": {
      "description": "Cells that omit version/actor/sha to exercise the matrix tile fallback chain (version→sha→ref→run_number) and missing-actor rendering. Do NOT add the omitted fields.",
      "entries": [
        "notification-worker|staging last_successful (gh-notif-staging-3081) — no version; sha present → sha fallback.",
        "order-svc|prod (gh-ordersvc-prod-2920) — no version, no sha; ref present → ref fallback.",
        "catalog-edge|qa current (gh-catalog-qa-5160) — no actor (first-ever deploy to qa, in-progress).",
        "ledger-projector|qa current (gh-ledger-qa-1828) — no actor, no version (in-progress retry).",
        "billing-webhook|staging current (gh-billhook-staging-825) — no actor (first-ever deploy, in-progress)."
      ]
    }
  },

  "services": [
    "auth-bff",
