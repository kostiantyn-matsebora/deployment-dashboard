{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File .agents/ginee/adapters/claude/statusline.ps1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "command": "pwsh -NoProfile -File .agents/ginee/adapters/claude/hooks/pre-tool-use-edit.ps1",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "pwsh -NoProfile -File .agents/ginee/adapters/claude/hooks/pre-tool-use-bash.ps1",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "command": "pwsh -NoProfile -File .agents/ginee/adapters/claude/hooks/pre-tool-use-send-message.ps1",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "pwsh -NoProfile -File .agents/ginee/adapters/claude/hooks/attest-optimized-by.ps1",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "pwsh -NoProfile -File .agents/ginee/adapters/claude/hooks/stop.ps1",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "pwsh -NoProfile -File .agents/ginee/adapters/claude/hooks/user-prompt-submit.ps1",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "command": "pwsh -NoProfile -File .agents/ginee/adapters/claude/hooks/post-tool-use-edit.ps1",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "pwsh -NoProfile -File .agents/ginee/adapters/claude/hooks/session-start.ps1",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.agents/ginee/core/**)",
      "Edit(.agents/ginee/adapters/**)",
      "Edit(.agents/ginee/extras/**)",
      "Write(.agents/ginee/core/**)",
      "Write(.agents/ginee/adapters/**)",
      "Write(.agents/ginee/extras/**)",
      "MultiEdit(.agents/ginee/core/**)",
      "MultiEdit(.agents/ginee/adapters/**)",
      "MultiEdit(.agents/ginee/extras/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}