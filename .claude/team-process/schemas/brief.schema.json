{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "team-process/schemas/brief.schema.json",
  "title": "BRIEF",
  "description": "orch -> role - dispatch. Canonical key order: type, spec, lane, task, gate, seed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "spec", "lane", "task", "gate"],
  "properties": {
    "type": { "enum": ["BRIEF"] },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "gate"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "minLength": 1 }
      }
    },
    "lane": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "task": { "type": "string", "minLength": 1 },
    "gate": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "seed": { "type": "string" }
  }
}
