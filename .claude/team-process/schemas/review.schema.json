{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "team-process/schemas/review.schema.json",
  "title": "REVIEW",
  "description": "reviewer -> orch - role-bar walk (or security-skill audit). Canonical key order: type, role, scope, checked, verdict, remarks, block. 'security' is a review-only competency (a generic agent running the security-review skill) - it never appears in RESULT, never implements. Cross-field rule (enforced in code, not schema): verdict 'pass' <=> zero remarks; 'changes-requested' => >=1 remark.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "role", "scope", "checked", "verdict"],
  "properties": {
    "type": { "enum": ["REVIEW"] },
    "role": { "enum": ["contract", "backend", "frontend", "infrastructure", "testing", "docs", "security"] },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "checked": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "verdict": { "enum": ["pass", "changes-requested"] },
    "remarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["smell", "location", "change"],
        "properties": {
          "smell": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "change": { "type": "string", "minLength": 1 }
        }
      }
    },
    "block": { "type": "string", "minLength": 1 }
  }
}
