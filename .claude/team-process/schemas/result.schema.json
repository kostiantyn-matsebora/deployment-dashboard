{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "team-process/schemas/result.schema.json",
  "title": "RESULT",
  "description": "role -> orch - hand-back. Canonical key order: type, role, changed, gate, notes, follow, block.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "role", "changed", "gate"],
  "properties": {
    "type": { "enum": ["RESULT"] },
    "role": { "enum": ["contract", "backend", "frontend", "infrastructure", "testing", "docs"] },
    "changed": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "gate": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
    "follow": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "block": { "type": "string", "minLength": 1 }
  }
}
