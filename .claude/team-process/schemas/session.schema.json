{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "team-process/schemas/session.schema.json",
  "title": "team-process session record",
  "description": "Durable run ledger for a /feature-team session. Written initial-minimal by the team-mode hook on TeamCreate; enriched by the orchestrator as the run proceeds (roster, phase, ledger). Its existence at .team-process/run/session.json = team mode active. Read on SessionStart to resume + remind. Most fields optional so the minimal hook-written record validates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["team", "createdAt"],
  "properties": {
    "team": { "type": "string", "minLength": 1, "description": "TeamCreate name (also the team_name members must set)." },
    "branch": { "type": "string", "description": "Git branch the run targets." },
    "issue": { "type": "string", "description": "Owning issue / spec ref, e.g. '#321'." },
    "phase": {
      "type": "string",
      "description": "Current process.md phase.",
      "enum": ["created", "intake", "contract", "plan-dispatch", "implement", "integrate", "review-loop", "fix-loop", "ship", "done"]
    },
    "createdAt": { "type": "string", "description": "ISO-8601 timestamp the session opened." },
    "updatedAt": { "type": "string", "description": "ISO-8601 timestamp of the last ledger update." },
    "roster": {
      "type": "array",
      "description": "Spawned members and their lanes.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role"],
        "properties": {
          "role": { "type": "string" },
          "lane": { "type": "string" },
          "status": { "type": "string", "enum": ["spawned", "in-progress", "returned", "done"] }
        }
      }
    },
    "ledger": {
      "type": "array",
      "description": "One entry per wave: what changed / was decided / was deferred.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wave"],
        "properties": {
          "wave": { "type": "integer" },
          "changed": { "type": "array", "items": { "type": "string" } },
          "decided": { "type": "string" },
          "deferred": { "type": "string" }
        }
      }
    }
  }
}
