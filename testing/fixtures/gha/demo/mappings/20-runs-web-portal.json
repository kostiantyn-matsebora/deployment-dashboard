{
  "_comment": "Needs-recovery — runs DTO for web-portal. Matches /actions/runs/<run_id> where run_id begins with the service prefix digit '1'. Returned path + head_sha drive the contents mapping below.",
  "Priority": 100,
  "Request": {
    "Methods": [
      "GET"
    ],
    "Path": {
      "Matchers": [
        {
          "Name": "RegexMatcher",
          "Pattern": "^/repos/demo-org/demo-repo/actions/runs/1[0-9]+$"
        }
      ]
    }
  },
  "Response": {
    "StatusCode": 200,
    "Headers": {
      "Content-Type": "application/json; charset=utf-8",
      "X-RateLimit-Limit": "5000",
      "X-RateLimit-Remaining": "4999",
      "X-RateLimit-Reset": "9999999999"
    },
    "BodyAsJson": {
      "id": 0,
      "path": ".github/workflows/web-portal-deploy.yml",
      "head_sha": "1aaa11111111aaaaaaaaaaaaaaaaaaaaaaa11111"
    }
  }
}
