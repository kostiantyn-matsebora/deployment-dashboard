{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist-tsc",
    "rootDir": "."
  },
  "include": [
    "playwright.config.ts",
    "playwright.extension.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-tsc"
  ]
}
