# Frontend upstream — startup-resolved; gateway depends_on: frontend (service_healthy).
# Container Apps: set FRONTEND_UPSTREAM to the FQDN assigned by the platform.
upstream frontend    { server ${FRONTEND_UPSTREAM}; }

# API upstream — always resolvable before gateway starts (depends_on: api).
upstream api         { server ${API_UPSTREAM}; }

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 256k;

    # DNS resolver — platform-specific.
    #   Docker Compose (embedded DNS):     DNS_RESOLVER=127.0.0.11  (default)
    #   Azure Container Apps (Azure DNS):  DNS_RESOLVER=168.63.129.16
    # Required by variable-based proxy_pass locations (demo-driver — optional service).
    # valid=10s means nginx re-resolves the variable at most once per 10 s so transient
    # restarts of optional containers recover quickly without gateway restart.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    # Inherited by every proxy_pass location that declares no proxy_set_header
    # of its own (nginx resets the inherited set the moment a location defines any
    # proxy_set_header directive — see the SSE block which re-declares all four).
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;

    # ── Gateway liveness ────────────────────────────────────────────────────────
    # Served locally; never forwarded to an upstream (routing matrix §4).
    location = /health {
        return       200 "ok\n";
        access_log   off;
        default_type text/plain;
    }

    # ── API SSE stream ──────────────────────────────────────────────────────────
    # Every buffering / batching layer is disabled (spec §5, NFR-03: 5 s delivery).
    # proxy_set_header is re-declared in full because any declaration in a location
    # block cancels the server-level inheritance.
    location = /api/events/stream {
        proxy_pass                 http://api;
        proxy_http_version         1.1;
        proxy_set_header           Host              $host;
        proxy_set_header           X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header           X-Forwarded-Proto $scheme;
        proxy_set_header           Connection        '';
        proxy_buffering            off;
        proxy_cache                off;
        gzip                       off;
        proxy_read_timeout         3600s;
        chunked_transfer_encoding  on;
    }

    # ── Demo driver SSE streams (spec §5 — same settings, upstream = demo-driver) ─
    # Variable-based proxy_pass: demo-driver is an optional service. The resolver
    # directive above enables lazy resolution so the gateway starts cleanly when
    # demo-driver is not running; requests return 502 until it is available.
    location = /demo/stream {
        set                        $dd http://${DEMO_DRIVER_UPSTREAM};
        proxy_pass                 $dd;
        proxy_http_version         1.1;
        proxy_set_header           Host              $host;
        proxy_set_header           X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header           X-Forwarded-Proto $scheme;
        proxy_set_header           Connection        '';
        proxy_buffering            off;
        proxy_cache                off;
        gzip                       off;
        proxy_read_timeout         3600s;
        chunked_transfer_encoding  on;
    }

    location = /demo/control-stream {
        set                        $dd http://${DEMO_DRIVER_UPSTREAM};
        proxy_pass                 $dd;
        proxy_http_version         1.1;
        proxy_set_header           Host              $host;
        proxy_set_header           X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header           X-Forwarded-Proto $scheme;
        proxy_set_header           Connection        '';
        proxy_buffering            off;
        proxy_cache                off;
        gzip                       off;
        proxy_read_timeout         3600s;
        chunked_transfer_encoding  on;
    }

    # ── API — JSON read/write; default buffering ────────────────────────────────
    location /api/ {
        proxy_pass http://api;
    }

    # ── Demo driver — control API + panel (§4, D9) ──────────────────────────────
    # Variable-based proxy_pass defers DNS resolution so the gateway starts
    # cleanly when the demo-driver container is not running (opt-in service).
    location /demo/ {
        set        $dd http://${DEMO_DRIVER_UPSTREAM};
        proxy_pass $dd;
    }

    # ── Ops probes — proxied to API (GW4) ──────────────────────────────────────
    location = /healthz { proxy_pass http://api; }
    location = /readyz  { proxy_pass http://api; }

    # ── API docs — Scalar reference UI + OpenAPI document (read-only, GW10) ──────
    # Reachable through the single public surface; same default buffering as /api/.
    # Bare /scalar redirects to /scalar/v1; the SPA must not swallow these paths.
    location = /scalar  { proxy_pass http://api; }
    location /scalar/   { proxy_pass http://api; }
    location /openapi/  { proxy_pass http://api; }

    # ── Frontend SPA ────────────────────────────────────────────────────────────
    # try_files fallback is owned by the frontend container (GW3).
    # Startup-resolved via the `upstream frontend` block above — no variable
    # proxy_pass needed; the gateway depends_on: frontend (service_healthy) so the
    # name is always resolvable at start. On Azure Container Apps this form is
    # required: variable proxy_pass does not resolve FQDN upstreams correctly.
    location / {
        proxy_pass http://frontend;
    }
}
