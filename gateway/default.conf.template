# Frontend upstream — startup-resolved; gateway depends_on: frontend (service_healthy).
# Container Apps: set FRONTEND_UPSTREAM to the FQDN assigned by the platform.
upstream frontend    { server ${FRONTEND_UPSTREAM}; }

# API upstream — always resolvable before gateway starts (depends_on: api).
upstream api         { server ${API_UPSTREAM}; }

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 256k;

    # Server-level proxy defaults — do NOT set Host here.
    # nginx cancels server-level proxy_set_header inheritance the moment a
    # location declares any proxy_set_header of its own, so every proxy
    # location re-declares Host + forwarded headers in full (see each block).
    # ACA fix: $host is the gateway's public hostname; ACA's internal Envoy
    # routes by Host header to the upstream FQDN — so Host must be the target
    # FQDN, set per-location, never the public-facing $host.
    proxy_http_version 1.1;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;

    # ── Gateway liveness ────────────────────────────────────────────────────────
    # Served locally; never forwarded to an upstream (routing matrix §4).
    location = /health {
        return       200 "ok\n";
        access_log   off;
        default_type text/plain;
    }

    # ── API SSE stream ──────────────────────────────────────────────────────────
    # Every buffering / batching layer is disabled (spec §5, NFR-03: 5 s delivery).
    # proxy_set_header is re-declared in full because any declaration in a location
    # block cancels the server-level inheritance.
    # Host set to upstream FQDN — required for ACA Envoy routing (see note above).
    location = /api/events/stream {
        proxy_pass                 http://api;
        proxy_http_version         1.1;
        proxy_set_header           Host              ${API_UPSTREAM};
        proxy_set_header           X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header           X-Forwarded-Proto $scheme;
        proxy_set_header           Connection        '';
        proxy_buffering            off;
        proxy_cache                off;
        gzip                       off;
        proxy_read_timeout         3600s;
        chunked_transfer_encoding  on;
    }

    # ── API — JSON read/write; default buffering ────────────────────────────────
    location /api/ {
        proxy_pass       http://api;
        proxy_set_header Host              ${API_UPSTREAM};
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Ops probes — proxied to API (GW4) ──────────────────────────────────────
    location = /healthz {
        proxy_pass       http://api;
        proxy_set_header Host              ${API_UPSTREAM};
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /readyz {
        proxy_pass       http://api;
        proxy_set_header Host              ${API_UPSTREAM};
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── API docs — Scalar reference UI + OpenAPI document (read-only, GW10) ──────
    # Reachable through the single public surface; same default buffering as /api/.
    # Bare /scalar redirects to /scalar/v1; the SPA must not swallow these paths.
    location = /scalar {
        proxy_pass       http://api;
        proxy_set_header Host              ${API_UPSTREAM};
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /scalar/ {
        proxy_pass       http://api;
        proxy_set_header Host              ${API_UPSTREAM};
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /openapi/ {
        proxy_pass       http://api;
        proxy_set_header Host              ${API_UPSTREAM};
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Frontend SPA ────────────────────────────────────────────────────────────
    # try_files fallback is owned by the frontend container (GW3).
    # Startup-resolved via the `upstream frontend` block above — no variable
    # proxy_pass needed; the gateway depends_on: frontend (service_healthy) so the
    # name is always resolvable at start. On Azure Container Apps this form is
    # required: variable proxy_pass does not resolve FQDN upstreams correctly.
    location / {
        proxy_pass       http://frontend;
        proxy_set_header Host              ${FRONTEND_UPSTREAM};
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Demo extension point ────────────────────────────────────────────────────
    # Zero matches in production = legal nginx no-op.
    # The demo-gateway image (Dockerfile.demo) adds demo.snippet (via COPY of
    # demo.snippet.template which envsubst renders to conf.d/demo.snippet at start).
    include /etc/nginx/conf.d/*.snippet;
}
