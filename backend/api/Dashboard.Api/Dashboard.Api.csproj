<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dashboard.Api</RootNamespace>
    <!-- The API serves JSON only; the SPA lives in its own nginx container
         behind the App Gateway. Disabling static web assets prevents the SDK
         from emitting a manifest that references a non-existent wwwroot. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- CR-0008 OpenAPI semantic enrichment: generate XML doc files so the
         Microsoft.AspNetCore.OpenApi pipeline can lift /// <summary> blocks
         onto operations and DTO schemas. 1591 suppressed because not every
         internal helper needs a /// block — only public surface ships. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />
    <!-- Retained for local-dev migration authoring (`dotnet ef migrations add`
         from the host). CI no longer runs `dotnet ef migrations script` post-
         ADR-0009; the package is design-time-only (PrivateAssets=all) so it
         doesn't ship in the runtime image. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\write-api\Dashboard.WriteApi\Dashboard.WriteApi.csproj" />
    <ProjectReference Include="..\..\read-api\Dashboard.ReadApi\Dashboard.ReadApi.csproj" />
    <ProjectReference Include="..\..\shared\Dashboard.Shared\Dashboard.Shared.csproj" />
  </ItemGroup>

</Project>
