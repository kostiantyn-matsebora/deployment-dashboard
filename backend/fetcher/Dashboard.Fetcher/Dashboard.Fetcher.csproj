<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dashboard.Fetcher</RootNamespace>
    <!--
      Same XML-doc posture as the other backend libraries — emit /// blocks
      next to the assembly so any future OpenAPI / consumer that reads the
      library has rich metadata. 1591 suppressed for internal helpers.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!--
    CR-0009 + ADR-0004: pull-mode adapter library. The host project
    (backend/fetcher-host/) is the only entry point; this library exposes
    the ICiCdAdapter contract + the GHA implementation + the worker /
    scheduler + the typed Write-API client. DTOs are reused from
    Dashboard.Shared (no duplication per CR-0009 § Reuse-the-canonical-DTO).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
    <!--
      Issue #19 + ADR-0007: needed by the GHA adapter to parse workflow YAML
      so per-job `needs:` declarations can be turned into ParentDeployments
      edges (intra-run DAG). Adapter-internal only — no DTO surface change.
    -->
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Dashboard.Shared\Dashboard.Shared.csproj" />
  </ItemGroup>

</Project>
