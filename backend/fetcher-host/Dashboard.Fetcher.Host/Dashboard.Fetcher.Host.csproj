<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dashboard.Fetcher.Host</RootNamespace>
    <UserSecretsId>dashboard-fetcher-host</UserSecretsId>
    <!--
      NFR-04: no inbound surface. The Worker SDK gives us HostBuilder
      without an HTTP listener — the only network traffic this image
      makes is OUTBOUND (Write API + CI/CD tool API).
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\fetcher\Dashboard.Fetcher\Dashboard.Fetcher.csproj" />
  </ItemGroup>

</Project>
