<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct dependency: ControlEventBroadcaster opens a NpgsqlConnection for LISTEN/NOTIFY. -->
    <PackageReference Include="Npgsql" Version="10.0.*" />
    <!-- State machine for the reset choreography (D12). -->
    <PackageReference Include="Stateless" Version="5.20.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Dashboard.Shared\Dashboard.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Dashboard.Control.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
