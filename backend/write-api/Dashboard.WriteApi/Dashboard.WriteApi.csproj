<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dashboard.WriteApi</RootNamespace>
  </PropertyGroup>

  <!--
    Reference the ASP.NET Core shared framework so this class library can
    expose Minimal-API endpoint extensions and DI registration helpers
    without dragging in a full web-host transitive closure. The host
    project (backend/api/) is the only project that builds as Microsoft.NET.Sdk.Web.
    See SAD §7 "Backend module architecture" + §10 Decision 11.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Dashboard.Shared\Dashboard.Shared.csproj" />
  </ItemGroup>

</Project>
