<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dashboard.ReadApi</RootNamespace>
    <!-- CR-0008 OpenAPI semantic enrichment: XML docs emitted next to the
         assembly so the OpenAPI generator can lift /// comments off endpoint
         delegates and helper types. 1591 suppressed so the build doesn't
         flood with "missing comment" warnings on internal helpers. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!--
    Reference the ASP.NET Core shared framework so this class library can
    expose Minimal-API endpoint extensions and DI registration helpers.
    The Read API serves JSON only — no static-asset middleware — and the
    host (backend/api/) is the only project that builds as Microsoft.NET.Sdk.Web.
    See SAD §7 "Backend module architecture" + §10 Decision 11.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Dashboard.Shared\Dashboard.Shared.csproj" />
  </ItemGroup>

</Project>
