{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": ".",
  "projects": {
    "dashboard": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css",
          "standalone": true,
          "changeDetection": "OnPush"
        }
      },
      "root": "dashboard",
      "sourceRoot": "dashboard/src",
      "prefix": "dd",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/dashboard",
            "index": "dashboard/src/index.html",
            "browser": "dashboard/src/main.ts",
            "polyfills": [],
            "tsConfig": "dashboard/tsconfig.app.json",
            "assets": [],
            "styles": ["dashboard/src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "2mb", "maximumError": "4mb" },
                { "type": "anyComponentStyle", "maximumWarning": "8kb", "maximumError": "16kb" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "dashboard/src/environments/environment.ts",
                  "with": "dashboard/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "dashboard:build:production" },
            "development": {
              "buildTarget": "dashboard:build:development",
              "proxyConfig": "dashboard/proxy.conf.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [],
            "tsConfig": "dashboard/tsconfig.spec.json",
            "assets": [],
            "styles": ["dashboard/src/styles.css"],
            "scripts": []
          }
        }
      }
    },
    "shared": {
      "projectType": "library",
      "root": "shared",
      "sourceRoot": "shared/src",
      "prefix": "dd",
      "schematics": {
        "@schematics/angular:component": { "standalone": true }
      },
      "architect": {
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [],
            "tsConfig": "shared/tsconfig.spec.json"
          }
        }
      }
    },
    "matrix": {
      "projectType": "library",
      "root": "matrix",
      "sourceRoot": "matrix/src",
      "prefix": "dd",
      "schematics": {
        "@schematics/angular:component": { "standalone": true }
      },
      "architect": {
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [],
            "tsConfig": "matrix/tsconfig.spec.json"
          }
        }
      }
    },
    "drawer": {
      "projectType": "library",
      "root": "drawer",
      "sourceRoot": "drawer/src",
      "prefix": "dd",
      "schematics": {
        "@schematics/angular:component": { "standalone": true }
      },
      "architect": {
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [],
            "tsConfig": "drawer/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
