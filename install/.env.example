# ─────────────────────────────────────────────────────────────────────────────
# Deployment Dashboard — environment variable reference
#
# Copy to .env and fill in values for your target profile.
#
#   demo        — no changes needed; all defaults work out of the box.
#   full        — set API_KEY, POSTGRES_PASSWORD.
#   standalone  — set API_KEY, POSTGRES_HOST + credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────

# Host port the API container binds to.
# Default: 8080
#API_PORT=8080

# Write-endpoint shared secret (X-Api-Key header).
# Required for full/standalone.  Demo default: demo-api-key.
#API_KEY=change-me

# Comma-separated allowed CORS origins.
# Empty string disables CORS (use when fronted by the App Gateway on the same origin).
# Default: * (open — suitable for demo/local only).
#CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# Deployment history retention window in days.  Minimum: 90.
# Default: 30 (demo-friendly).  Recommended for production: 365.
#HISTORY_RETENTION_DAYS=365

# ── PostgreSQL (full / demo profiles) ─────────────────────────────────────────

# Database name.
# Default: deployment_dashboard
#POSTGRES_DB=deployment_dashboard

# Database user.
# Default: dashboard
#POSTGRES_USER=dashboard

# Database password.
# Required for full (no secure default).  Demo default: changeme.
#POSTGRES_PASSWORD=change-me

# ── PostgreSQL (standalone profile only) ──────────────────────────────────────

# Hostname or IP of the external PostgreSQL instance.
# Default: postgres (the bundled service name — override for standalone).
#POSTGRES_HOST=db.internal.example.com

# External PostgreSQL port.
# Default: 5432
#POSTGRES_PORT=5432
