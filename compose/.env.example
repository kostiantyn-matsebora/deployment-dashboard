# ─────────────────────────────────────────────────────────────────────────────
# Deployment Dashboard — environment variable reference
#
# Copy to .env and fill in values for your target profile.
#
#   standalone       — set API_KEY, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_HOST.
#   standalone-pull  — as standalone, plus GITHUB_* for the Fetcher pull source.
#   full             — set API_KEY, POSTGRES_USER, POSTGRES_PASSWORD.
#   full-pull        — as full, plus GITHUB_* for the Fetcher pull source.
#   demo             — set API_KEY, POSTGRES_USER, POSTGRES_PASSWORD.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stack version ─────────────────────────────────────────────────────────────

# Image tag applied to ALL stack images (gateway / frontend / api / fetcher /
# demo-driver / github-emulator). One unified version drives the whole stack.
# Default: latest (floating — tracks the newest push to main).
#
# For a reproducible deploy, pin to a published release tag. IMPORTANT: set the
# value WITHOUT the leading `v`. The release workflow tags via metadata-action,
# which strips the `v`, so a git tag `v0.1.0` publishes images as `0.1.0` (plus
# `0.1` and `latest`) — never `v0.1.0`. Using `DASHBOARD_VERSION=v0.1.0` would
# request a tag that does not exist. Use the bare SemVer:
#DASHBOARD_VERSION=0.1.0
# Note: the release build bakes this same version into the API assembly; the
# dashboard footer shows it via GET /api/version. Unstamped builds show 0.0.0-dev.

# ── API ───────────────────────────────────────────────────────────────────────

# Host port the gateway (the single public surface) binds to.
# Default: 8080
#GATEWAY_PORT=8080

# Write-endpoint shared secret (X-Api-Key header).
# Required for all profiles.
#API_KEY=

# Control-surface shared secret (X-Control-API-Key header).
# Optional — leave unset to hide POST /api/control/reset entirely (returns 404).
# When set, keep distinct from API_KEY (least-privilege: write credentials must
# not be able to trigger a destructive reset).
#CONTROL_API_KEY=

# Max seconds to await component acks before forcing drain (D13).
# Default: 10
#RESET_ACK_TIMEOUT_SECONDS=10

# Hard wall-clock ceiling on a reset cycle in seconds (D12).
# Default: 60
#RESET_GATE_MAX_TTL_SECONDS=60

# CSV of component ids whose acks are awaited during reset (D13).
# Default: dashboard-fetcher,demo-driver
#RESET_EXPECTED_COMPONENTS=dashboard-fetcher,demo-driver

# Comma-separated allowed CORS origins.
# Empty string (default) disables CORS — use when fronted by the App Gateway on the same origin.
# Set explicitly only when the API is exposed split-domain.
#CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# Deployment history retention window in days.  Minimum: 90.  Default: 365.
# Pruned daily by a background job.
#HISTORY_RETENTION_DAYS=365

# Analytics window boundary granularity: day | hour.
# Default: day (truncate window.to to start of UTC day — stable ETag for the
# whole UTC day; today's deploys enter DORA trends at the next UTC day boundary).
# hour yields fresher data, stable within the hour. Matrix / Swimlanes are
# always real-time and unaffected.
#ANALYTICS_WINDOW_GRANULARITY=day

# Comma-separated, ordered environment ladder for the promotion funnel
# (per-stage counts + conversion chart). The LAST entry is the production
# terminal the DORA lead-time metric measures promotion chains to. Matched
# case-insensitively against the deployment `environment` field; environments
# outside this list are excluded from funnel stages.
# Default: dev,staging,qa,preprod,prod
#ANALYTICS_FUNNEL_ENVIRONMENTS=dev,staging,qa,preprod,prod

# Deployment-wide service exclude filter (API container only — the fetcher does
# not use this var). CSV of glob patterns matched against the event's opaque
# namespace/service identity (namespace is emitter-supplied and may contain /).
# A pattern without `/` matches the service segment across all namespaces; a
# pattern with `/` globs the full composite and `*` spans `/`.
# Write effect: POST /api/deployments rejects a matching event with 403.
# Read effect: matching events are hidden from /api/services, /api/matrix,
# /api/deployments, the SSE stream, and analytics; by-id returns 404.
# Default: empty (exclude nothing).
#SERVICE_EXCLUDE=acme/*,*/canary

# ── PostgreSQL (full / full-pull / demo profiles) ─────────────────────────────

# Database name.
# Default: deployment_dashboard
#POSTGRES_DB=deployment_dashboard

# Database user.
# Required for all profiles.
#POSTGRES_USER=

# Database password.
# Required for all profiles.
#POSTGRES_PASSWORD=

# Npgsql SSL mode override.
# Unset: managed-identity mode defaults to SslMode=Require; static-password mode omits SslMode.
# Set to pass the value verbatim (Disable | Allow | Prefer | Require | VerifyCA | VerifyFull).
#POSTGRES_SSL_MODE=

# ── PostgreSQL (standalone / standalone-pull profiles — external DB) ──────────

# Hostname or IP of the external PostgreSQL instance.
# Default: postgres (the bundled service name — override for standalone).
#POSTGRES_HOST=db.internal.example.com

# External PostgreSQL port.
# Default: 5432
#POSTGRES_PORT=5432

# ── Fetcher (standalone-pull / full-pull / fetcher-host profiles) ─────────────
# Opt-in pull→push edge. Only needed when running a `-pull` profile (or the
# `fetcher-host` service alone) against real GitHub.
# The `demo` profile repoints the fetcher at the in-stack github-emulator and
# supplies its own demo values, so none of these are required for demo.
#
# The fetcher reads these GITHUB_* vars directly. Like all settings, an
# appsettings `GitHub` section may provide base values; GITHUB_* env vars override.

# GitHub REST API base URL the fetcher polls.
# Default: https://api.github.com  (GitHub Enterprise Server: https://<host>/api/v3)
#GITHUB_BASE_URL=https://api.github.com

# GitHub token (PAT / App token). Required when polling real GitHub.
#GITHUB_TOKEN=

# Repos to poll. Accepts exact owner/repo, owner/* (all repos of one owner), or
# bare * (every repo the token can access). Glob forms trigger GitHub API
# discovery within the existing rate-limit budget.
# Empty = no repos polled — empty is NOT equivalent to *.
#GITHUB_REPOS=acme/api,acme/web

# Version source: attribute:<attr> | payload:<field> | artifact:<filename>.
# Default: attribute:sha
#GITHUB_VERSION_SOURCE=attribute:sha

# Percentage of the GitHub hourly quota the fetcher may consume (1-100).
# Default: 30
#GITHUB_RATE_LIMIT_BUDGET_PCT=30

# Fetcher poll cadence in seconds.
# Default: 30 (the demo profile uses 10).
#POLL_INTERVAL_SECONDS=30

# How far back backfill scans per environment (TimeSpan format: d.hh:mm:ss).
# Default: falls back to INITIAL_LOOKBACK (7 days) when unset.
#BACKFILL_MAX_AGE=30.00:00:00

# Force a one-time backfill run regardless of cursor state (F14).
# Default: false
#BACKFILL=false

# Normal-poll first-run lookback window (TimeSpan d.hh:mm:ss); also the backfill
# fallback when BACKFILL_MAX_AGE is unset (F7).
# Default: 7.00:00:00 (7 days)
#INITIAL_LOOKBACK=7.00:00:00

# Number of latest status events to seed per (service, environment) slot during backfill.
# Default: 2 (the two most recent mapped status events per slot).
#BACKFILL_DEPTH=2

# Optional service-identity overrides (comma-sep key=value pairs).
# Key without `/` = workflow-level override; key with `/` = repo-level override (§5.8.3).
#GITHUB_SERVICE_MAP=

# Total hourly GitHub request quota.  0 = auto-discover via GET /rate_limit on startup (F16).
# Default: 0
#GITHUB_RATE_LIMIT=0

# GitHub-adapter workflow exclude filter. CSV of glob patterns over
# owner/repo/workflow (GitHub names never contain `/`, so `*` matches within a
# segment only). Matching workflows are never ingested by the fetcher — use to
# cut rate-limit spend on unwanted pipelines. GitHub-specific; future provider
# adapters expose their own analogous exclude.
# Default: empty (exclude nothing).
#GITHUB_WORKFLOW_EXCLUDE=acme/web/legacy-*,*/*/canary

# ── Demo / dev only (set by docker-compose.demo.yaml — NOT required for any production profile) ──

# Demo driver / emulator event emission interval in milliseconds.
# Default: 8000
#EMIT_INTERVAL_MS=8000

# Demo driver startup emission delay in milliseconds.
# Default: 0
#EMIT_DELAY_MS=0

# Simulated GitHub hourly quota in the emulator.
# Default: 5000
#GITHUB_SIM_RATE_LIMIT=5000

# Shift fixture timestamps to anchor the newest event to seed-time (demo time-bomb fix).
# Default: true (ON). Set to false/0/no to preserve raw fixture dates — required when
# pairing fixed-date fixtures with a pinned FETCHER_NOW clock (e.g. api-tests overlay).
#SEED_RELATIVE_DATES=true

# Other demo vars (WRITE_API_URL, FETCHER_URL, GITHUB_EMULATOR_URL, MOCK_URL, PORT,
# SEED_ON_STARTUP, SCENARIOS_DIR) are fixed internal wiring set by the demo overlay
# and are not meant to be overridden.
